# Import libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

# ------------------------------------------------------------
# 1. LOAD DATASET
# ------------------------------------------------------------

file_path = "OnlineRetail.csv"     # Change to your dataset name

df = pd.read_csv(file_path, encoding="latin1")

print("=" * 70)
print("CUSTOMER SEGMENTATION ANALYSIS")
print("=" * 70)

print("\nDataset Shape:", df.shape)

print("\nFirst 5 Records:")
print(df.head())

# ------------------------------------------------------------
# 2. INSPECT DATA
# ------------------------------------------------------------

print("\nColumn Names:")
print(df.columns.tolist())

print("\nData Types:")
print(df.dtypes)

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Rows:")
print(df.duplicated().sum())

# ------------------------------------------------------------
# 3. CLEAN DATA
# ------------------------------------------------------------

# Remove rows without CustomerID
if "CustomerID" in df.columns:
    df = df.dropna(subset=["CustomerID"])

# Remove rows with missing InvoiceDate
if "InvoiceDate" in df.columns:
    df = df.dropna(subset=["InvoiceDate"])

# Convert InvoiceDate into datetime
if "InvoiceDate" in df.columns:
    df["InvoiceDate"] = pd.to_datetime(
        df["InvoiceDate"],
        errors="coerce"
    )

# Remove invalid dates
df = df.dropna(subset=["InvoiceDate"])

# Remove cancelled transactions
if "InvoiceNo" in df.columns:
    df["InvoiceNo"] = df["InvoiceNo"].astype(str)
    df = df[~df["InvoiceNo"].str.startswith("C")]

# Remove negative or zero quantities
if "Quantity" in df.columns:
    df = df[df["Quantity"] > 0]

# Remove zero/negative prices
if "UnitPrice" in df.columns:
    df = df[df["UnitPrice"] > 0]

print("\nShape After Cleaning:", df.shape)

# ------------------------------------------------------------
# 4. CREATE TOTAL PURCHASE VALUE
# ------------------------------------------------------------

df["TotalAmount"] = df["Quantity"] * df["UnitPrice"]

print("\nTotal Amount Created Successfully!")

print(df[[
    "CustomerID",
    "Quantity",
    "UnitPrice",
    "TotalAmount"
]].head())

# ------------------------------------------------------------
# 5. DESCRIPTIVE STATISTICS
# ------------------------------------------------------------

print("\n" + "=" * 70)
print("DESCRIPTIVE STATISTICS")
print("=" * 70)

print("\nAverage Purchase Value:")
print(df["TotalAmount"].mean())

print("\nMedian Purchase Value:")
print(df["TotalAmount"].median())

print("\nMaximum Purchase Value:")
print(df["TotalAmount"].max())

print("\nMinimum Purchase Value:")
print(df["TotalAmount"].min())

# Purchase frequency
purchase_frequency = df.groupby(
    "CustomerID"
)["InvoiceNo"].nunique()

print("\nAverage Purchase Frequency:")
print(purchase_frequency.mean())

# ------------------------------------------------------------
# 6. RFM ANALYSIS
# ------------------------------------------------------------

print("\n" + "=" * 70)
print("RFM ANALYSIS")
print("=" * 70)

# Reference date = day after last transaction
reference_date = df["InvoiceDate"].max() + pd.Timedelta(days=1)

rfm = df.groupby("CustomerID").agg({

    "InvoiceDate": lambda x:
        (reference_date - x.max()).days,

    "InvoiceNo": "nunique",

    "TotalAmount": "sum"
})

# Rename columns
rfm.columns = [
    "Recency",
    "Frequency",
    "Monetary"
]

print("\nRFM Table:")
print(rfm.head())

# ------------------------------------------------------------
# 7. RFM STATISTICS
# ------------------------------------------------------------

print("\nRFM Statistics:")
print(rfm.describe())

# ------------------------------------------------------------
# 8. RFM DISTRIBUTION
# ------------------------------------------------------------

plt.figure(figsize=(8, 5))

sns.histplot(
    rfm["Recency"],
    bins=30,
    kde=True
)

plt.title("Customer Recency Distribution")
plt.xlabel("Recency (Days)")
plt.ylabel("Number of Customers")

plt.tight_layout()
plt.show()


plt.figure(figsize=(8, 5))

sns.histplot(
    rfm["Frequency"],
    bins=30,
    kde=True
)

plt.title("Customer Purchase Frequency")
plt.xlabel("Number of Purchases")
plt.ylabel("Number of Customers")

plt.tight_layout()
plt.show()


plt.figure(figsize=(8, 5))

sns.histplot(
    rfm["Monetary"],
    bins=30,
    kde=True
)

plt.title("Customer Monetary Value")
plt.xlabel("Total Spending")
plt.ylabel("Number of Customers")

plt.tight_layout()
plt.show()

